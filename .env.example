# Copier ce fichier en .env avant de lancer le projet :
#   cp .env.example .env   (ou "copy .env.example .env" sous Windows)
#
# JWT_SECRET est OBLIGATOIRE (docker compose refuse de démarrer sans elle).
# Générez une valeur forte, par exemple avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

POSTGRES_DB=formy
POSTGRES_USER=formy
POSTGRES_PASSWORD=formy

JWT_SECRET=REMPLACEZ_MOI_PAR_UNE_VALEUR_ALEATOIRE_LONGUE

ADMIN_EMAIL=admin@formy.fr
ADMIN_PASSWORD=ChangeMe123!

PGADMIN_EMAIL=admin@formy.fr
PGADMIN_PASSWORD=admin

# CORS_ORIGINS : liste d'origines autorisées séparées par des virgules.
# Laisser vide en développement (le frontend est servi par la même origine).
CORS_ORIGINS=

# FranceConnect (optionnel) : laisser vide tant que vous n'avez pas de
# client_id/secret sandbox obtenus auprès de la DINUM. Le bouton de connexion
# FranceConnect reste alors simplement masqué.
FC_CLIENT_ID=
FC_CLIENT_SECRET=
FC_ISSUER=
FC_REDIRECT_URI=

FRONTEND_URL=http://localhost:8080
PUBLIC_BASE_URL=http://localhost:8080

# Passer à "true" uniquement si l'app est servie en HTTPS (reverse proxy TLS
# en production) : sinon les navigateurs refusent silencieusement les cookies.
COOKIE_SECURE=false
